<section id="contact" class="card scroll-panel">
  <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-orange-500">
    03 / Get In Touch
  </p>

  <div class="grid gap-8 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Let's build together!</h2>
      <p class="mt-4 max-w-lg text-sm leading-7 text-slate-600 dark:text-slate-400">
        Have an idea or project in mind? Send a message and tell me what you would like to build.
      </p>

      <div class="mt-6 rounded-2xl bg-orange-50 p-5 dark:bg-orange-950/30">
        <p class="font-bold text-orange-600 dark:text-orange-400">Let's make it happen.</p>
        <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">
          Good projects begin with a clear idea and a conversation.
        </p>
      </div>
    </div>

    <form id="contactForm" class="flex flex-col gap-3">
      <label for="name">Name</label>
      <input class="field" type="text" id="name" name="name" placeholder="Your name" required />

      <label for="email">Email</label>
      <input
        class="field"
        type="email"
        id="email"
        name="email"
        placeholder="Your email"
        required
      />

      <label for="message">Message</label>
      <textarea
        class="field"
        id="message"
        name="message"
        rows="5"
        placeholder="Your message"
        required
      ></textarea>

      <button type="submit" class="btn mt-2">Send Message</button>
      <p id="formStatus" class="text-sm text-slate-500" aria-live="polite"></p>
    </form>
  </div>
</section>
