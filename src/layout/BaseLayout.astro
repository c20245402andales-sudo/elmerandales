---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Elmer L. Andales builds websites, digital systems, and user-friendly tools."
    />
    <title>Elmer L. Andales</title>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"></script>
  </head>

  <body id="top" class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <Header />

    <main class="mx-auto max-w-7xl space-y-10 px-5 pb-20 sm:px-8">
        <slot />
    </main>

    <Footer />

  </body>
</html>
